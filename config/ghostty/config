theme = jellybeans
font-family = JetBrainsMono Nerd Font
font-size = 18
background-blur = 20
mouse-hide-while-typing = true
macos-option-as-alt = true
# 'tabs' style is Ghostty's custom titlebar, tested only through macOS 14.
# On macOS 26+ it collapses every tab into one pill at the window edge.
macos-titlebar-style = transparent

shell-integration-features = cursor,sudo,title,ssh-env

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
cursor-style = block
cursor-style-blink = true
mouse-scroll-multiplier = 2
resize-overlay = never
font-thicken = true
font-feature = -calt

config-file = ?config.local
